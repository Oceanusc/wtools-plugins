{
  "name": "wtools-video-batch",
  "title": "视频批量处理",
  "description": "批量视频压缩、时长裁剪、画面裁剪、格式转换、转为动图、添加水印、修改尺寸、视频封面、视频加速、视频翻转、视频旋转、视频合并、音频处理与帧提取。",
  "version": "1.0.0",
  "author": "WTools",
  "main": "index.html",
  "logo": "logo.svg",
  "platform": ["win32"],
  "pluginSetting": {
    "width": 960,
    "height": 640,
    "minWidth": 410,
    "minHeight": 300
  },
  "features": [
    {
      "code": "compress",
      "explain": "批量视频压缩（支持 MP4 H.264 / H.265）",
      "cmds": [
        "视频批量处理",
        "视频压缩",
        "批量压缩视频",
        {
          "type": "files",
          "label": "视频批量处理",
          "fileType": "file",
          "match": "/\\.(mp4|mov|mkv|avi|flv|wmv|webm|m4v|ts|mts|3gp)$/i"
        }
      ]
    },
    { "code": "trim", "cmds": ["时长裁剪", "视频裁剪时长", "剪掉片头", "剪掉片尾"] },
    { "code": "crop", "cmds": ["画面裁剪", "视频比例裁剪"] },
    { "code": "convert", "cmds": ["格式转换", "视频格式转换", "视频转格式"] },
    { "code": "animated", "cmds": ["转为动图", "视频转 GIF", "视频转 WebP"] },
    { "code": "watermark", "cmds": ["添加水印", "视频水印", "批量视频水印"] },
    { "code": "resize", "cmds": ["修改尺寸", "视频改尺寸", "视频分辨率"] },
    { "code": "cover", "cmds": ["视频封面", "设置视频封面"] },
    { "code": "speed", "cmds": ["视频加速", "视频倍速"] },
    { "code": "flip", "cmds": ["视频翻转", "视频镜像"] },
    { "code": "rotate", "cmds": ["视频旋转"] },
    { "code": "merge", "cmds": ["视频合并", "视频拼接"] },
    { "code": "audio", "cmds": ["音频处理", "提取音频", "删除音频"] },
    { "code": "frames", "cmds": ["帧提取", "视频抽帧", "提取视频帧"] }
  ]
}
